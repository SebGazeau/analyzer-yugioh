# Copier en .env et adapter (docker compose charge .env automatiquement).
# Ne pas committer .env (mots de passe).

# --- Environnement
# En production (Cloud Run, etc.) : APP_ENV=production impose ADMIN_SECRET et SESSION_SECRET
# d’au moins 32 octets UTF-8 chacun (voir security_startup).
# APP_ENV=production
# En prod, Swagger UI est désactivé par défaut. Pour l’activer : ENABLE_SWAGGER_UI=true
# ENABLE_SWAGGER_UI=false

# --- App (make dev)
PORT=8080
CARDS_PATH=legacy/assets/cards.json

# Optionnel : URL complète cardinfo YGOProDeck (défaut = API publique v7). Sert pour `sync-cards` et `/fetch_cards` (mode DB).
# YGOPRODECK_CARDINFO_URL=https://db.ygoprodeck.com/api/v7/cardinfo.php

# Locale pour `konami-pack-index` (site db.yugioh-card.com) : en, fr, de, it, es, pt, ja, ko…
# KONAMI_LOCALE=en

# Locales YGOProDeck pour `./analyzer-yugioh sync-locales-ygo` (virgules). Même base URL que `YGOPRODECK_CARDINFO_URL` + `?misc=yes&language=`.
# CARD_LOCALES_YGO=fr,de,it,pt

# `sync-locales-konami` : après `konami-pack-index` pour la même locale. Limite la charge en dev :
# KONAMI_LOCALE_SYNC_MAX_PACKS=2
# KONAMI_LOCALE_SYNC_MAX_DETAILS=50
# KONAMI_REQUEST_DELAY_MS=250

# --- PostgreSQL (service db)
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=analyzer
POSTGRES_DB=analyzer_yugioh

# URL pour l’app et pour `make db-migrate` / `cargo run -- migrate` **sur l’hôte** :
# utiliser 127.0.0.1:5433 (port mappé dans docker-compose.yml), pas `db` (réservé au réseau Docker).
# Dans le conteneur `app`, compose injecte déjà @db:5432 — pour migrer sans toucher .env : `make docker-db-migrate` ou `make docker-dev MIGRATE=1`.
# DATABASE_URL=postgres://analyzer:analyzer@127.0.0.1:5433/analyzer_yugioh

# Tests schéma sur une vraie base : `make test-db` (voir docs/db-migrations.md)
# TEST_DATABASE_URL=postgres://analyzer:analyzer@127.0.0.1:5433/analyzer_yugioh

# --- pgAdmin (interface http://localhost:5050)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

ADMIN_SECRET=ta-cle-secrete-ici

# --- API JWT (/api/auth/token, /api/profile)
# JWT_SECRET signe les JWT. API_ISSUER_SECRET est la clé dans le JSON POST /api/auth/token.
# Si API_ISSUER_SECRET est absent, la même valeur que JWT_SECRET est utilisée (warning au démarrage).
# JWT_SECRET=...
# API_ISSUER_SECRET=une-autre-cle-longue-et-aleatoire
# OBLIGATOIRE en prod (avec APP_ENV=production) : >= 32 caractères ; recommandé en local aussi.
# SESSION_SECRET=remplis-avec-au-moins-32-caracteres-aleatoires

# --- Rate limiting auth (sec-10), fenêtre 1 minute par adresse IP
# SITE_AUTH_RATE_LIMIT_PER_MINUTE=30   # POST /login uniquement
# REGISTER_RATE_LIMIT_PER_MINUTE=5
# ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=15
# RESET_AUTH_RATE_LIMIT_PER_MINUTE=10  # POST /auth/forgot-password + /auth/reset/* + /auth/2fa/*
# RESET_ADMIN_ISSUE_RATE_LIMIT_PER_MINUTE=20 # POST /admin/password-reset/*/issue-temp-code
# PROFILE_2FA_SETUP_RATE_LIMIT_PER_MINUTE=6
# PROFILE_2FA_ENABLE_RATE_LIMIT_PER_MINUTE=10
# PROFILE_2FA_ROTATE_RATE_LIMIT_PER_MINUTE=5

# --- Cloudflare Turnstile (/register) : les deux clés requises pour activer le widget + vérif serveur.
# Clés de test (toujours « succès ») : https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Import HTTP images (SSRF / taille)
# Suffixes d’hôte autorisés (virgules). Défaut : ygoprodeck.com
# IMAGE_IMPORT_ALLOWED_HOST_SUFFIXES=ygoprodeck.com
# Plafond octets téléchargés (1024..100Mi). Défaut : 15 MiB
# IMAGE_IMPORT_MAX_BYTES=15728640

# --- Stockage images (optionnel)
# STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=./storage
# Cloud Run + bucket GCS privé (même projet) :
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=ton-bucket